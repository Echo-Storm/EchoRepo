    <addon id="plugin.program.echolauncher" name="Echo Launcher" version="1.1.0" provider-name="Echo-Storm">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video audio executable</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Your own shelves of add-ons for the home screen</summary>
            <description lang="en_GB">Keeps short lists (Video, Stream) of the add-ons you open most and shows them as folders, so a skin can use them as home screen widgets. Add add-ons to a list from a picker; remove or move them from the context menu. No service, no network, no keymaps.</description>
            <news>1.1.0: a shelf holds at most 5 add-ons, which is what the Silvo Panel widget shows in one row (setting); editing only inside the add-on; remove asks first; entries of missing add-ons can be removed.
1.0.0: first version. Replaces the Super Favourites folders used for the home screen widgets.</news>
            <platform>all</platform>
            <license>MIT</license>
            <source>https://github.com/Echo-Storm</source>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="plugin.video.echoondemand" name="Echo OnDemand" version="4.0.1" provider-name="Echo-Storm">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
            <import addon="xbmc.gui" version="5.17.0" />
            <import addon="script.module.resolveurl" />
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Echo OnDemand — IPTV VOD + Wrestling + Fights + Live Sports</summary>
            <description lang="en_GB">Browse and play Movies and Series from your Xtream Codes IPTV service, plus three on-demand replay sources via debrid: Wrestling Rewind, Wrestling on Demand (WWE / AEW / TNA / NJPW / ROH / NWA / Indy / Documentaries / Archive), and Fights on Demand (UFC PPV and Fight Night, MMA, Boxing — including a Free / No Debrid sub-menu). Includes a Live category with WOD's wrestling channels and curated Pluto TV sports streams (Golf, F1, UFC, Bellator, ONE, Top Rank Classics, DAZN Ringside). Pluto channels are resolved with fresh session tokens at play time. Settings backup/restore protects credentials across reinstalls. Movies listed by genre. Series support full season and episode navigation. Results cached locally. Kodi Omega (v21) compatible. Requires script.module.resolveurl with an active debrid account.</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
